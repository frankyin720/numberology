# 前端驗證信連結根路徑
# NUMEROLOGY_PUBLIC_URL=http://localhost:4200
#
# Brevo SMTP（未設定 SPRING_MAIL_HOST 時驗證連結僅輸出到後端日誌）
# Login = Brevo 後台 SMTP & API 頁的 Login；Password = 該頁建立的 SMTP key（非帳號密碼）
# From 須為 Brevo 已驗證的發件人信箱
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# BREVO_SMTP_LOGIN=xxxxxxxx@smtp-brevo.com
# 或 SPRING_MAIL_USERNAME=同上
# BREVO_SMTP_KEY=你的SMTP_KEY（勿提交 git；可设为本机环境变量）
# 或沿用 SPRING_MAIL_PASSWORD（yml 优先读取 BREVO_SMTP_KEY）
# NUMEROLOGY_MAIL_FROM=你在Brevo驗證過的email@example.com

DEEPSEEK_API_KEY=
# LLM 请求/响应格式化日志（logger: llm.exchange）
# LLM_LOG_INTERACTIONS=false
# 需要调用缘分居 API 时设为 true
YUANFENJU_ENABLED=false
YUANFENJU_BASE_URL=https://api.yuanfenju.com/index.php/v1
YUANFENJU_API_KEY=
# 可选：覆盖单个接口（填绝对 URL 或相对路径）
# YUANFENJU_BAZI_PATH=/Bazi/cesuan
# YUANFENJU_ZHANBU_PATH=/Zhanbu/meiri
# YUANFENJU_ZHOUGONG_PATH=/Gongju/zhougong
SERPAPI_ENABLED=false
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_API_KEY=
# SQLite 文件路径（相对 backend 工作目录），默认 ./data/numerology.db
# NUMEROLOGY_DB_PATH=./data/numerology.db
